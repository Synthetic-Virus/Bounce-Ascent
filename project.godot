; Bounce Ascent - engine configuration.
;
; This file is normally edited through the Godot editor UI, but it is kept
; hand-readable here because the project is developed largely outside the
; editor. Every non-default value below is deliberate; see docs/ARCHITECTURE.md
; for the reasoning behind the audio and physics settings in particular.

config_version=5

[application]

config/name="Bounce Ascent"
config/description="A beat-synced vertical climb. Every jump arc is quantised to
the music, so landing on a platform and landing on a beat are the same event."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; Order matters. Settings must exist before Music reads the calibration offset,
; and Music must exist before Conductor asks it for the audio clock.
Settings="*res://autoload/settings.gd"
Music="*res://autoload/music.gd"
Conductor="*res://autoload/conductor.gd"
Scores="*res://autoload/scores.gd"

[display]

; Portrait. The climb reads best in a tall aspect, and it keeps the playfield
; narrow enough that horizontal steering stays a meaningful decision.
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

; Phones vary from 16:9 to over 20:9. "expand" keeps the 720-wide reference
; width and grows the viewport vertically instead of letterboxing, so a taller
; screen shows MORE playfield rather than black bars. UI is anchored and
; safe-area aware, so nothing lands under a notch.
window/handheld/orientation=1

