[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="platform"

[physics]

; The game computes its own gravity in scripts/tuning.gd so that jump arcs can
; be solved analytically against the beat clock. The engine default is disabled
; here to make sure nothing silently applies a second, unquantised gravity.
2d/default_gravity=0.0

; 120Hz physics rather than the default 60.
;
; Landings are resolved by collision, so the moment a landing is detected can be
; up to one physics tick late. At 60Hz that is 16.7ms of jitter, which would eat
; a third of the +/-45ms PERFECT window. At 120Hz it is 8.3ms, comfortably below
; the noise floor of human timing. This costs nothing measurable for a 2D game
; with a few dozen bodies.
common/physics_ticks_per_second=120

; Allow more catch-up ticks after a stall than the default 8.
;
; This matters more here than in most games. Jump arcs are solved against the
; AUDIO clock but simulated in physics time, so if physics falls behind real
; time, landings arrive late and -- because each hop is solved from the audio
; clock again -- the lag compounds rather than self-correcting. A stalled run
; was observed drifting from 48ms to 220ms of landing error over 26 seconds.
;
; At 120Hz, 8 steps covers only 67ms of catch-up per frame, so any hitch longer
; than that is lost permanently. 24 covers 200ms, which absorbs a GC pause or a
; background process spike. Higher values risk a spiral of death on genuinely
; underpowered hardware, which is why this is not simply set very large.
common/max_physics_steps_per_frame=24

[rendering]

; Compatibility renderer: this is a 2D game with no need for Forward+, and it
; keeps the export small and the hardware requirements near zero.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

; Required for the Android export, which refuses to run without it. Costs
; nothing here: the game ships no textures, so there is nothing to compress.
textures/vram_compression/import_etc2_astc=true

; HDR in 2D, so a colour brighter than white means something.
;
; Without this every colour clamps at 1.0 and the glow pass has no way to tell
; "the neon core of the player" from "a pale background band": everything either
; blooms or nothing does. With it, the game draws its emissive parts ABOVE 1.0
; and the glow threshold picks exactly those out.
;
; This is what replaces the hand-stacked translucent shapes that used to fake
; bloom. Those cost 4 to 6 extra draws per object per frame and still only
; approximated it, because a stack of flat alpha is not a blur.
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.07, 1)
anti_aliasing/quality/msaa_2d=2
